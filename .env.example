# Copy this file to .env and fill in real values. Never commit .env.

# Django secret key — generate a fresh one for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Comma-separated list of allowed hosts (production only — local.py hardcodes dev hosts)
ALLOWED_HOSTS=localhost,127.0.0.1

# Google OAuth (Python Social Auth) — from Google Cloud Console > Credentials
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=

# Comma-separated emails auto-approved as super_admin on first login
SUPERADMIN_EMAILS=

# Optional Fernet key (urlsafe-base64, 32 bytes) for encrypting connector credentials at rest
APP_ENCRYPTION_KEY=

# Public URLs (production only — local.py hardcodes localhost)
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8000/api/gmail/connect/callback

UPSTOX_CLIENT_ID=REDACTED_UPSTOX_CLIENT_ID
UPSTOX_CLIENT_SECRET=REDACTED_UPSTOX_CLIENT_SECRET
UPSTOX_REDIRECT_URI=http://localhost:8000/api/upstox/callback