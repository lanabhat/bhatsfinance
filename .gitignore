.venv/
__pycache__/
*.pyc
db.sqlite3
db.sqlite3-journal
db.sqlite3.backup-*
db.sqlite3_bkp_*
frontend/node_modules/

# Claude Code local session/tooling state
.claude/

# Scratch captures (HARs, exports) — may contain cookies/tokens
temp/

# Secrets — never commit real environment values
.env
.env.*
!.env.example

# Collected static files (regenerated via collectstatic on deploy)
staticfiles/

# Local scratch files (bank statements, personal exports) — never commit
Files/
Account statement files/

# Dev server PID files / logs (scripts/dev-server.ps1)
.dev-server/
